<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Client"
             x:Class="Client.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator></local:ViewLocator>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="Assets/Styles/AppStyles.axaml"></StyleInclude>
    </Application.Styles>

    <Application.Resources>
        <SolidColorBrush x:Key="PrimaryTextColor">#EAE8E8</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryBackgroundColor">#04041F</SolidColorBrush>

        <LinearGradientBrush x:Key="PrimaryBackgroundGradient" StartPoint="0% 0%" EndPoint="100% 0%">
            <GradientStop Offset="0" Color="#04041F"/>
            <GradientStop Offset="1" Color="#151E3E"/>
        </LinearGradientBrush>
    </Application.Resources>

</Application>